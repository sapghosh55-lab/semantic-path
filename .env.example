# Gateway Settings
HOST=0.0.0.0
PORT=8000
ROUTES_FILE=routes.yaml
SIMILARITY_THRESHOLD=0.45
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Fast/Local Tier (Gemma 2 via local Ollama)
FAST_MODEL_NAME=gemma2:2b
FAST_MODEL_BASE_URL=http://localhost:11434/v1
FAST_MODEL_API_KEY=ollama
FAST_MODEL_COST_PER_1K_INPUT=0.0001
FAST_MODEL_COST_PER_1K_OUTPUT=0.0002

# Cloud Frontier Tier - Option 1: Google Gemini (OpenAI-compatible)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Cloud Frontier Tier - Option 2: Groq / OpenAI
FRONTIER_MODEL_NAME=llama-3.3-70b-versatile
FRONTIER_MODEL_BASE_URL=https://api.groq.com/openai/v1
FRONTIER_MODEL_API_KEY=your_groq_or_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

FRONTIER_MODEL_COST_PER_1K_INPUT=0.015
FRONTIER_MODEL_COST_PER_1K_OUTPUT=0.015
